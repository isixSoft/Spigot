{
  "version": "1.0.0",
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "active": true,
    "longDescription": "Spigot:\u5728 Clash Verge Rev \u57fa\u7840\u4e0a\u589e\u52a0\u4e86\u300c\u4e00\u952e\u63a8\u9001\u7f8e\u56fd\u8282\u70b9\u5230 Deno\u300d\u7684\u81ea\u7528\u5ba2\u6237\u7aef\u3002",
